{
  "name": "claw-auto-research",
  "version": "1.0.0",
  "description": "Multi-agent automated research plugin for OpenClaw",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./openclaw.plugin.json": "./openclaw.plugin.json"
  },
  "scripts": {
    "build": "tsc && node scripts/prepare-dist-runtime.mjs && node scripts/verify-dist-runtime.mjs",
    "dashboard:dev": "npm --prefix apps/workflow-dashboard run dev",
    "dashboard:build": "npm --prefix apps/workflow-dashboard run build",
    "dashboard:test": "npm --prefix apps/workflow-dashboard run test",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "prepare": "npm run build",
    "lint": "eslint index.ts tools/",
    "test": "node --test $(find tests -name '*.test.mjs' -type f | sort)",
    "test:agents": "node --test $(find tests/agents -name '*.test.mjs' -type f | sort)",
    "test:distribution": "node --test $(find tests/distribution -name '*.test.mjs' -type f | sort)",
    "test:e2e": "node --test $(find tests/e2e -name '*.test.mjs' -type f | sort)",
    "test:experiment": "node --test $(find tests/experiment -name '*.test.mjs' -type f | sort)",
    "test:gateway": "node --test $(find tests/gateway -name '*.test.mjs' -type f | sort)",
    "test:idea-catalyst": "node --test $(find tests/idea-catalyst -name '*.test.mjs' -type f | sort)",
    "test:literature": "node --test $(find tests/literature -name '*.test.mjs' -type f | sort)",
    "test:lobster": "node --test $(find tests/lobster -name '*.test.mjs' -type f | sort)",
    "test:paper-ingestion": "node --test $(find tests/paper-ingestion -name '*.test.mjs' -type f | sort)",
    "test:papernexus": "node --test $(find tests/papernexus -name '*.test.mjs' -type f | sort)",
    "test:plugin": "node --test $(find tests/plugin -name '*.test.mjs' -type f | sort)",
    "test:research-memory": "node --test $(find tests/research-memory -name '*.test.mjs' -type f | sort)",
    "test:research-writing": "node --test $(find tests/research-writing -name '*.test.mjs' -type f | sort)",
    "test:survey": "node --test $(find tests/survey -name '*.test.mjs' -type f | sort)",
    "test:workflow": "node --test $(find tests/workflow -name '*.test.mjs' -type f | sort)",
    "test:workflow:auto-iterator": "node --test $(find tests/workflow/auto-iterator -name '*.test.mjs' -type f | sort)",
    "test:workflow:commands": "node --test $(find tests/workflow/commands -name '*.test.mjs' -type f | sort)",
    "test:workflow:control-plane": "node --test $(find tests/workflow/control-plane -name '*.test.mjs' -type f | sort)",
    "test:workflow:derived-state": "node --test $(find tests/workflow/derived-state -name '*.test.mjs' -type f | sort)",
    "test:workflow:diagnostics": "node --test $(find tests/workflow/diagnostics -name '*.test.mjs' -type f | sort)",
    "test:workflow:discussion": "node --test $(find tests/workflow/discussion -name '*.test.mjs' -type f | sort)",
    "test:workflow:docs": "node --test $(find tests/workflow/docs -name '*.test.mjs' -type f | sort)",
    "test:workflow:evidence": "node --test $(find tests/workflow/evidence -name '*.test.mjs' -type f | sort)",
    "test:workflow:execution": "node --test $(find tests/workflow/execution -name '*.test.mjs' -type f | sort)",
    "test:workflow:frontier-mapping": "node --test $(find tests/workflow/frontier-mapping -name '*.test.mjs' -type f | sort)",
    "test:workflow:guard": "node --test $(find tests/workflow/guard -name '*.test.mjs' -type f | sort)",
    "test:workflow:handoff": "node --test $(find tests/workflow/handoff -name '*.test.mjs' -type f | sort)",
    "test:workflow:hooks": "node --test $(find tests/workflow/hooks -name '*.test.mjs' -type f | sort)",
    "test:workflow:kernel": "node --test $(find tests/workflow/kernel -name '*.test.mjs' -type f | sort)",
    "test:workflow:project": "node --test $(find tests/workflow/project -name '*.test.mjs' -type f | sort)",
    "test:workflow:prompting": "node --test $(find tests/workflow/prompting -name '*.test.mjs' -type f | sort)",
    "test:workflow:runtime": "node --test $(find tests/workflow/runtime -name '*.test.mjs' -type f | sort)",
    "test:workflow:team": "node --test $(find tests/workflow/team -name '*.test.mjs' -type f | sort)",
    "test:workflow:writing": "node --test $(find tests/workflow/writing -name '*.test.mjs' -type f | sort)",
    "test:workflow:zotero": "node --test $(find tests/workflow/zotero -name '*.test.mjs' -type f | sort)",
    "test:auto:fixture": "node scripts/run_auto_workflow_e2e_test.mjs --mode fixture --command full",
    "test:auto:local-live": "node scripts/run_auto_workflow_e2e_test.mjs --mode live --command full --bootstrap-transport local",
    "test:auto:discord-parity": "node scripts/run_auto_workflow_e2e_test.mjs --mode live --command full --bootstrap-transport discord",
    "test:auto:real": "node scripts/run_auto_workflow_e2e_test.mjs --mode live --command full --bootstrap-transport discord",
    "test:autoresearch:local-live": "node scripts/run_auto_workflow_e2e_test.mjs --mode live --command /autoresearch --bootstrap-transport local",
    "test:autoresearch:discord-parity": "node scripts/run_auto_workflow_e2e_test.mjs --mode live --command /autoresearch --bootstrap-transport discord",
    "test:autoresearch:real": "node scripts/run_auto_workflow_e2e_test.mjs --mode live --command /autoresearch --bootstrap-transport discord",
    "test:autoreview:local-live": "node scripts/run_auto_workflow_e2e_test.mjs --mode live --command /autoreview --bootstrap-transport local",
    "test:autoreview:discord-parity": "node scripts/run_auto_workflow_e2e_test.mjs --mode live --command /autoreview --bootstrap-transport discord",
    "test:autoreview:real": "node scripts/run_auto_workflow_e2e_test.mjs --mode live --command /autoreview --bootstrap-transport discord",
    "install:plugin": "bash install.sh"
  },
  "keywords": [
    "openclaw",
    "plugin",
    "research",
    "automation",
    "multi-agent",
    "paper-writing",
    "experiment-management"
  ],
  "author": "ClawAutoResearch Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/OpenClawThings/ClawAutoResearch.git"
  },
  "bugs": {
    "url": "https://github.com/OpenClawThings/ClawAutoResearch/issues"
  },
  "homepage": "https://github.com/OpenClawThings/ClawAutoResearch#readme",
  "files": [
    "dist/",
    "tools/",
    "skills/",
    "agents/",
    "lobster/",
    "templates/",
    "install.sh",
    "openclaw.plugin.json",
    "SKILL.md",
    "README.md",
    "WORKFLOW.md",
    "WORKSPACE.md",
    "CONFIG.md",
    "workflow-prompts.config.json"
  ],
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^20.0.0",
    "eslint": "^9.39.4",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.58.2",
    "vitepress": "^1.6.3"
  },
  "peerDependencies": {
    "openclaw": ">=2026.3.24"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "pluginId": "ClawAutoResearch"
  }
}
