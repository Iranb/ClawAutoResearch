{
  "name": "claw-auto-research",
  "version": "1.0.0",
  "description": "Multi-agent automated research plugin for OpenClaw",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./openclaw.plugin.json": "./openclaw.plugin.json"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "lint": "eslint index.ts tools/",
    "test": "node --test tests/*.test.mjs",
    "install:plugin": "bash install.sh"
  },
  "keywords": [
    "openclaw",
    "plugin",
    "research",
    "automation",
    "multi-agent",
    "paper-writing",
    "experiment-management"
  ],
  "author": "ClawAutoResearch Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/OpenClawThings/ClawAutoResearch.git"
  },
  "bugs": {
    "url": "https://github.com/OpenClawThings/ClawAutoResearch/issues"
  },
  "homepage": "https://github.com/OpenClawThings/ClawAutoResearch#readme",
  "files": [
    "dist/",
    "tools/",
    "skills/",
    "agents/",
    "lobster/",
    "templates/",
    "install.sh",
    "openclaw.plugin.json",
    "SKILL.md",
    "README.md",
    "WORKFLOW.md",
    "WORKSPACE.md",
    "CONFIG.md"
  ],
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "openclaw": ">=2026.3.24"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "openclaw": {
    "extensions": ["./dist/index.js"],
    "pluginId": "ClawAutoResearch"
  }
}
