{
  // OpenClaw Research — Multi-Agent Automated Research Configuration
  // Agent roster: researcher (orchestrator) + 4 sub-agents + reviewer (isolated)
  // Memory: QMD backend, per-agent isolation; project-level memory under projectsRoot

  // ── 项目根目录：独立于各 agent 的 workspace，所有 agent 均可访问（可指定为任意路径）
  projectsRoot: "~/.openclaw/projects",

  agents: {
    list: [
      // ── Main Orchestrator ──────────────────────────────────────────
      {
        id: "researcher",
        name: "Researcher",
        default: true,
        workspace: "~/.openclaw/workspace-researcher",
        agentDir: "./agents/researcher",
        model: {
          default: "modelstudio/glm-5"
        },
        // Researcher has access to its own skill set only
        skills: ["~/.openclaw/skills", "./skills/researcher"],
        subagents: {
          maxSpawnDepth: 2,
          allowAgents: ["orchestrator", "coder", "analyzer", "academic_writer", "reviewer"]
        },
        sandbox: {
          mode: "off"  // needs SSH access to remote GPU servers
        },
        tools: {
          allow: ["*"],
          deny: []
        }
      },

      // ── Orchestrator Sub-agent ──────────────────────────────────────────
      {
        id: "orchestrator",
        name: "Orchestrator",
        workspace: "~/.openclaw/workspace-researcher",  // shares researcher workspace (read access)
        agentDir: "./agents/orchestrator",
        model: {
          default: "modelstudio/glm-5"
        },
        // Planner has only its own planning skill
        skills: ["~/.openclaw/skills", "./skills/orchestrator"],
        sandbox: {
          mode: "non-main"
        },
        tools: {
          allow: ["read", "write", "edit"],
          deny: ["bash", "exec", "process"]
        }
      },

      // ── Coder Sub-agent ───────────────────────────────────────────
      {
        id: "coder",
        name: "Coder",
        workspace: "~/.openclaw/workspace-researcher",
        agentDir: "./agents/coder",
        model: {
          default: "modelstudio/glm-5"
        },
        // Coder has only its own implementation skill
        skills: ["~/.openclaw/skills", "./skills/coder"],
        sandbox: {
          mode: "non-main"
        },
        tools: {
          allow: ["read", "write", "edit", "bash"],
          // bash allowed for local dry-run validation only (no SSH)
          deny: []
        }
      },

      // ── Analyzer Sub-agent ────────────────────────────────────────
      {
        id: "analyzer",
        name: "Analyzer",
        workspace: "~/.openclaw/workspace-researcher",
        agentDir: "./agents/analyzer",
        model: {
          default: "modelstudio/glm-5"
        },
        // Analyzer has only its own analysis skill
        skills: ["~/.openclaw/skills", "./skills/analyzer"],
        sandbox: {
          mode: "non-main"
        },
        tools: {
          allow: ["read", "write", "edit", "bash"],
          // bash allowed for running Python analysis/plotting scripts
          deny: []
        }
      },

      // ── Writer Sub-agent ──────────────────────────────────────────
      {
        id: "academic_writer",
        name: "Writer",
        workspace: "~/.openclaw/workspace-researcher",
        agentDir: "./agents/academic_writer",
        model: {
          default: "modelstudio/glm-5"
        },
        // Writer has paper-writing skills (plan, write, compile, phase)
        skills: ["~/.openclaw/skills", "./skills/academic_writer"],
        sandbox: {
          mode: "non-main"
        },
        tools: {
          allow: ["read", "write", "edit", "web_search", "web_fetch"],
          deny: ["bash", "exec", "process"]
        }
      },

      // ── Reviewer Agent (experiment review, fully isolated) ────────
      {
        id: "reviewer",
        name: "Reviewer",
        workspace: "~/.openclaw/workspace-reviewer",  // isolated workspace — cannot see researcher memory
        agentDir: "./agents/reviewer",
        model: {
          // ── USER-CONFIGURABLE ─────────────────────────────────────
          // Change this to any model available in your OpenClaw setup.
          // Recommended: a strong reasoning model different from researcher's.
          // Examples: "modelstudio/glm-5", "modelstudio/kimi-k2.5"
          default: "modelstudio/glm-5"
        },
        // Reviewer has only review-phase skill
        skills: ["~/.openclaw/skills", "./skills/reviewer"],
        sandbox: {
          mode: "all",
          scope: "agent"
        },
        tools: {
          allow: ["read", "write", "edit", "memory_search", "memory_get", "web_search", "web_fetch"],
          deny: ["bash", "exec", "process"]
        }
      },

      // ── Cross-Reviewer Agent (novelty + outline + prose critique) ──
      // Replaces all mcp__codex__ calls for review/validation purposes.
      // Invoked via sessions_send from: novelty-check, paper-plan, paper-write, paper-phase.
      {
        id: "cross-reviewer",
        name: "Cross-Reviewer",
        workspace: "~/.openclaw/workspace-cross-reviewer",
        agentDir: "./agents/cross-reviewer",
        model: {
          default: "modelstudio/glm-5"
        },
        sandbox: {
          mode: "all",
          scope: "agent"
        },
        tools: {
          allow: ["read", "web_search", "web_fetch"],
          // Read-only: cross-reviewer never modifies files
          deny: ["write", "edit", "bash", "exec", "process"]
        }
      }
    ],

    defaults: {
      compaction: {
        memoryFlush: {
          enabled: true,
          softThresholdTokens: 4000
        }
      }
    }
  },

  // QMD Memory — per-agent isolation via separate workspaces
  memory: {
    backend: "qmd",
    citations: "auto",
    qmd: {
      includeDefaultMemory: true,
      update: { interval: "5m", debounceMs: 15000 },
      limits: { maxResults: 8, timeoutMs: 5000 },
      scope: {
        default: "deny",
        rules: [
          { action: "allow", match: { chatType: "direct" } }
        ]
      }
    }
  },

  // Discord notifications
  channels: {
    discord: {
      // Discord webhook configured via user settings
    }
  },

  // Tool configuration（远程执行；多机时由 skills 从 servers.list 选 host，此处保持与 servers.default 一致）
  tools: {
    exec: {
      host: "gateway",
      security: "allowlist"
    }
  }
}
