{
  "name": "claw-auto-research",
  "version": "1.0.0",
  "description": "Multi-agent automated research plugin for OpenClaw",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./openclaw.plugin.json": "./openclaw.plugin.json"
  },
  "scripts": {
    "build": "tsc && node scripts/prepare-dist-runtime.mjs && node scripts/verify-dist-runtime.mjs",
    "dashboard:dev": "npm --prefix apps/workflow-dashboard run dev",
    "dashboard:build": "npm --prefix apps/workflow-dashboard run build",
    "dashboard:test": "npm --prefix apps/workflow-dashboard run test",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "prepare": "npm run build",
    "lint": "eslint index.ts tools/",
    "test": "node --test tests/*.test.mjs",
    "test:auto:fixture": "node scripts/run_auto_workflow_e2e_test.mjs --mode fixture --command full",
    "test:auto:real": "node scripts/run_auto_workflow_e2e_test.mjs --mode live --command full",
    "test:autoresearch:real": "node scripts/run_auto_workflow_e2e_test.mjs --mode live --command /autoresearch",
    "test:autoreview:real": "node scripts/run_auto_workflow_e2e_test.mjs --mode live --command /autoreview",
    "install:plugin": "bash install.sh"
  },
  "keywords": [
    "openclaw",
    "plugin",
    "research",
    "automation",
    "multi-agent",
    "paper-writing",
    "experiment-management"
  ],
  "author": "ClawAutoResearch Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/OpenClawThings/ClawAutoResearch.git"
  },
  "bugs": {
    "url": "https://github.com/OpenClawThings/ClawAutoResearch/issues"
  },
  "homepage": "https://github.com/OpenClawThings/ClawAutoResearch#readme",
  "files": [
    "dist/",
    "tools/",
    "skills/",
    "agents/",
    "lobster/",
    "templates/",
    "install.sh",
    "openclaw.plugin.json",
    "SKILL.md",
    "README.md",
    "WORKFLOW.md",
    "WORKSPACE.md",
    "CONFIG.md"
  ],
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^20.0.0",
    "eslint": "^9.39.4",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.58.2",
    "vitepress": "^1.6.3"
  },
  "peerDependencies": {
    "openclaw": ">=2026.3.24"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "pluginId": "ClawAutoResearch"
  }
}
